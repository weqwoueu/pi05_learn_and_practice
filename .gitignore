# Python 虚拟环境：换电脑后用 uv sync 重建
.venv/
venv/
env/

# Python 缓存
__pycache__/
*.py[cod]

# 测试、类型检查和代码检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# 打包产物
build/
dist/
*.egg-info/

# Notebook 自动检查点与运行日志
.ipynb_checkpoints/
*.log

# 本机环境变量与密钥配置；保留可分享的模板
.env
.env.*
!.env.example
!.env.template

# 操作系统与编辑器临时文件
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# 需要提交：exercises/、tests/、notes/、README.md
# 以及 pyproject.toml、uv.lock、.python-version
# .vscode/settings.json 使用相对路径，可随仓库共享
